# BE-Project Environment Configuration
# Copy this file to .env and update values for your environment

# Application Configuration
NODE_ENV=development
PORT=8080

# JWT Configuration (MUST match cloud-backend JWT_SECRET for integration)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345
JWT_EXPIRY=24h

# Legacy support - kept for backward compatibility
ACCESS_TOKEN=your-super-secret-jwt-key-change-in-production-12345

# PostgreSQL Database Configuration
PG_DATABASE_USER=postgres
PG_DATABASE_HOST=localhost
PG_DATABASE_NAME=local_db_setup
PG_DATABASE_PORT=5432

# MySQL Database Configuration
MYSQL_DATABASE_USER=root
MYSQL_DATABASE_HOST=localhost
MYSQL_DATABASE_PORT=3306
MYSQL_DATABASE_PASSWORD=root

# Local database type (postgres or mysql or sqlite)
LOCAL_DB_TYPE=postgres

# Database Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8000,http://localhost:3001,*

# Logging
LOG_LEVEL=debug

# Optional: External LLM Query Generator Service
# QUERY_GENERATOR_URL=http://127.0.0.1:8000/api/query
# ENDPOINT_URL=http://127.0.0.1:8000/api/schema/upload
